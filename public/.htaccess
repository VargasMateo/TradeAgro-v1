<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Si el archivo o directorio solicitado existe, servirlo directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirigir todas las demás peticiones al index.html para que React se encargue del routing
  # Excluimos explícitamente /api y /backend para que no interfiera con el backend de Node
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/backend/
  RewriteRule ^ index.html [L]
</IfModule>
